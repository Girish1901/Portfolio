# ============================================================
# GIRISH PORTFOLIO — ENVIRONMENT VARIABLES
# Copy this file to .env for local development
# Add these as Environment Variables in your deployment platform
# (Vercel: Project Settings → Environment Variables)
# (Railway: Variables tab)
# ============================================================

# ------ FIREBASE (Web SDK — these are safe to be public) ------
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------ ADMIN AUTH (server-side — keep these secret!) ------
# Your Firebase admin login email
ADMIN_EMAIL=your_admin_email@gmail.com
# A strong password (used for the server-side session guard)
ADMIN_PASSWORD=choose_a_strong_password_here
# A random secret string for signing session cookies (any long random string)
SESSION_SECRET=some_very_long_random_secret_string_here

# ------ OPTIONAL: Upstash Redis (for persistent storage on Vercel) ------
# If you deploy to Vercel (serverless), Vercel doesn't have a writable filesystem.
# Add Upstash Redis from: Vercel Dashboard → Storage → Create Database → Upstash Redis
# Then copy these values from the Upstash Console:
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
